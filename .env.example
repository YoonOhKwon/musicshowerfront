OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=10000
# Artistic language is separate from the disabled legacy music-analysis API.
OPENAI_LANGUAGE_MODEL=gpt-5.6-sol
OPENAI_LANGUAGE_REASONING_EFFORT=medium
PORT=3000
# Comma-separated public frontend origins allowed to open the audio WebSocket.
# Leave empty only for local development.
# MUSIC_SHOWER_ALLOWED_ORIGINS=https://musicshower.example
MUSIC_SHOWER_ALLOWED_ORIGINS=
# Music Flamingo local server (scripts/flamingo_server.py)
# GPU audio encoder/projector + NF4 language decoder + system-RAM token embedding.
MUSIC_FLAMINGO_PLACEMENT=audio-priority
MUSIC_FLAMINGO_4BIT_QUANT_TYPE=nf4
MUSIC_FLAMINGO_EMPTY_CACHE=1

# Gemini (free tier) for token mode. Choose it in the front3 audio panel.
GEMINI_API_KEY=
# First model is used; the rest are fallbacks when a model is overloaded.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite
# Pacing under the free-tier limits shown in Google AI Studio.
GEMINI_RPM=10
GEMINI_RPD=900
# openai | gemini: provider used by clients that do not choose one.
LLM_DEFAULT_PROVIDER=openai
