+import * as THREE from "three";
+
+// One tiny texture supplies the sky and the cylindrical room's vertical colour wash.
+// It is created once, outside the render loop, and survives changes of design look.
+export function createY2kBackdrop(scene, showroom) {
+  const canvas = document.createElement("canvas");
+  canvas.width = 2;
+  canvas.height = 256;
+  const context = canvas.getContext("2d");
+  const gradient = context.createLinearGradient(0, 0, 0, canvas.height);
+  gradient.addColorStop(0, "#aaebfa");
+  gradient.addColorStop(0.42, "#9cc7f6");
+  gradient.addColorStop(1, "#a395e8");
+  context.fillStyle = gradient;
+  context.fillRect(0, 0, canvas.width, canvas.height);
+  const sky = new THREE.CanvasTexture(canvas);
+  sky.colorSpace = THREE.SRGBColorSpace;
+  return {
+    apply() {
+      scene.background = sky;
+      scene.fog?.color.set(0xa395e8);
+      const { wall, rib, dome } = showroom.materials;
+      if (wall.map !== sky) { wall.map = sky; wall.needsUpdate = true; }
+      wall.color.set(0xffffff);
+      rib.color.set(0xc0dbf7);
+      dome.color.set(0xaaebfa);
+    },
+    dispose() { sky.dispose(); },
+  };
+}
+
+export function mountY2kTaskbar() {
+  const panel = document.querySelector(".chrome.panel");
+  const player = document.querySelector("#soundcloud-player");
+  const title = document.querySelector("#soundcloud-player-title");
+  panel.id ||= "viewer-controls";
+  const bar = document.createElement("nav");
+  bar.className = "y2k-taskbar";
+  bar.setAttribute("aria-label", "Music Shower 작업표시줄");
+  bar.innerHTML = `
+    <button type="button" class="y2k-start" aria-label="음악 연결 열기" aria-controls="${panel.id}">
+      <span class="y2k-window-icon" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
+      <strong>Let's ride</strong>
+    </button>
+    <span class="y2k-grip" aria-hidden="true"></span>
+    <button type="button" class="y2k-track" aria-label="SoundCloud 플레이어 표시 전환" aria-controls="soundcloud-player" aria-pressed="true">
+      <span class="y2k-sunset" aria-hidden="true"></span><span class="y2k-track-name">SoundCloud</span>
+    </button>
+    <button type="button" class="y2k-settings" aria-label="설정 창 표시 전환" aria-controls="${panel.id}" aria-pressed="true">
+      <span class="y2k-settings-icon" aria-hidden="true">▤</span><span>설정</span>
+    </button>
+    <span class="y2k-taskbar-space" aria-hidden="true"></span>
+    <div class="y2k-tray"><span class="y2k-spark" aria-hidden="true">✧</span><time class="y2k-clock"></time></div>`;
+  document.querySelector("#app").append(bar);
+  const start = bar.querySelector(".y2k-start");
+  const track = bar.querySelector(".y2k-track");
+  const settings = bar.querySelector(".y2k-settings");
+  const clock = bar.querySelector(".y2k-clock");
+  const trackName = bar.querySelector(".y2k-track-name");
+  const sync = () => {
+    track.setAttribute("aria-pressed", String(!player.hidden));
+    settings.setAttribute("aria-pressed", String(!panel.hidden));
+    trackName.textContent = title?.textContent?.trim() || "SoundCloud";
+    track.title = trackName.textContent;
+  };
+  start.addEventListener("click", () => {
+    panel.hidden = false;
+    const audioTab = panel.querySelector('[data-tab="audio"]');
+    audioTab?.click();
+    document.querySelector("#token-mode")?.focus();
+  });
+  track.addEventListener("click", () => { player.hidden = !player.hidden; sync(); });
+  settings.addEventListener("click", () => { panel.hidden = !panel.hidden; sync(); });
+  // H / P shortcuts and incoming song metadata also update the taskbar state.
+  const observer = new MutationObserver(sync);
+  observer.observe(panel, { attributes: true, attributeFilter: ["hidden"] });
+  observer.observe(player, { attributes: true, attributeFilter: ["hidden"] });
+  if (title) observer.observe(title, { childList: true, characterData: true, subtree: true });
+  const updateClock = () => {
+    const now = new Date();
+    clock.textContent = now.toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit", hour12: true });
+    clock.dateTime = now.toISOString();
+    clock.title = now.toLocaleDateString("ko-KR", { dateStyle: "full" });
+  };
+  updateClock();
+  sync();
+  const timer = window.setInterval(updateClock, 1000);
+  return () => { clearInterval(timer); observer.disconnect(); bar.remove(); };
+}
